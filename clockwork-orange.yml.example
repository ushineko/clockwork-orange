# Example configuration for clockwork-orange (v4). Place it at
# ~/.config/clockwork-orange.yml. The window writes this file for you; this
# copy is for a hand-made start or for the daemon on a machine without a
# window. Keys are written sorted; unknown keys are kept.

# Which surfaces to change: dual (different images on desktop and lock
# screen), or desktop / lockscreen alone.
dual_wallpapers: true
# desktop: true
# lockscreen: true

# Seconds between changes for the window's timer and `--wait`; the service
# uses 900 when this is absent.
default_wait: 300

plugins:
  local:
    enabled: true
    path: ~/Pictures/Wallpapers
  wallhaven:
    enabled: false
    api_key: ""
    query:
      - {term: landscape, enabled: true}
    sorting: relevance        # relevance, random, views, favorites, toplist, date_added
    top_range: 1M             # for toplist: 1d 3d 1w 1M 3M 6M 1y
    category_general: true
    category_anime: false
    category_people: false
    purity_sfw: true
    purity_sketchy: false
    purity_nsfw: false
    atleast: 2560x1440
    ratios: 16x9
    download_dir: ~/Pictures/Wallpapers/Wallhaven
    interval: Daily           # Hourly, Daily, Weekly, always
    limit: 10                 # downloads per query per run
    max_files: 100            # oldest files beyond this are deleted
  duckduckgo_images:
    enabled: false
    query: 4k nature wallpapers
    download_dir: ~/Pictures/Wallpapers/DuckDuckGo
    interval: Daily
    limit: 10
    max_files: 50
